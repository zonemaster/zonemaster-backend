msgid "Invalid method parameter(s)."
msgstr "Некоректні параметри методу."

msgid "Missing property"
msgstr "Відсутня властивість"

msgid ""
"Warning: Zonemaster::LDNS not compiled with IDN support, cannot handle non-"
"ASCII names correctly."
msgstr ""
"Попередження: Zonemaster::LDNS скомпільовано без підтримки IDN, неможливо "
"коректно обробляти імена, що містять не-ASCII символи."

#. BACKEND_TEST_AGENT:TEST_DIED
msgid "An error occured and Zonemaster could not start or finish the test."
msgstr "Сталася помилка, і Zonemaster не зміг розпочати або завершити тест."

#. BACKEND_TEST_AGENT:UNABLE_TO_FINISH_TEST
#, perl-brace-format
msgid ""
"The test took too long to run (the current limit is {max_execution_time} "
"seconds). Maybe there are too many name servers or the name servers are "
"either unreachable or not responsive enough."
msgstr ""
"Тест виконувався занадто довго (поточний ліміт — {max_execution_time} "
"секунд). Можливо, серверів імен занадто багато, або сервери імен недоступні "
"чи недостатньо швидко відповідають."

msgid "Invalid digest format"
msgstr "Некоректний формат хешу"

msgid "Algorithm must be a positive integer"
msgstr "Алгоритм має бути додатним цілим числом"

msgid "Digest type must be a positive integer"
msgstr "Тип хешу має бути додатним цілим числом"

msgid "Keytag must be a positive integer"
msgstr "Тег ключа має бути додатним цілим числом"

msgid "Domain name required"
msgstr "Доменне ім'я є обов'язковим"

msgid "Invalid language tag format"
msgstr "Некоректний формат тегу мови"

msgid "Unkown language string"
msgstr "Невідомий рядок мови"

msgid "Invalid IP address"
msgstr "Некоректна IP-адреса"

msgid "Invalid profile format"
msgstr "Некоректний формат профілю"

msgid "Unknown profile"
msgstr "Невідомий профіль"
